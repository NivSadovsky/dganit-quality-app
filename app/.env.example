# Copy to .env and fill in for local dev. On Railway, set these as service
# environment variables instead (DATABASE_URL is auto-provided once a
# Postgres plugin is attached to the service).

DATABASE_URL="postgresql://user:password@host:5432/dbname"

# iron-session cookie encryption key — generate a fresh one per environment,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=""

# Local file storage root for uploaded PDFs / photos / generated reports.
# On Railway, point this at a mounted Volume (e.g. "/data") so files survive
# redeploys — the container filesystem is otherwise ephemeral.
STORAGE_DIR="./storage"
